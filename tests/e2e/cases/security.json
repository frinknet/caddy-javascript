[
  {
    "name": "env allowlist exposes the listed variable",
    "method": "GET",
    "path": "/env",
    "wantStatus": 200,
    "wantContentType": "application/json",
    "wantBodyContains": "\"secret\":\"s3cr3t\""
  },
  {
    "name": "env allowlist hides everything else",
    "method": "GET",
    "path": "/env",
    "wantStatus": 200,
    "wantBodyContains": "\"home\":null"
  },
  {
    "name": "fetch to an allowlisted host works",
    "method": "GET",
    "path": "/fetch-allowed",
    "wantStatus": 200,
    "wantBodyContains": "\"text\":\"hello world\""
  },
  {
    "name": "fetch to a non-allowlisted host is blocked",
    "method": "GET",
    "path": "/fetch-blocked",
    "wantStatus": 403,
    "wantBodyEquals": "blocked"
  }
]
