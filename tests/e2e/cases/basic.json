[
  {
    "name": "root returns json",
    "method": "GET",
    "path": "/",
    "wantStatus": 200,
    "wantContentType": "application/json",
    "wantBodyContains": "\"ok\":true"
  },
  {
    "name": "hello returns text",
    "method": "GET",
    "path": "/hello",
    "wantStatus": 200,
    "wantContentType": "text/plain",
    "wantBodyEquals": "hello world"
  },
  {
    "name": "echo returns created json",
    "method": "POST",
    "path": "/echo",
    "body": "{\"a\":1}",
    "headers": { "Content-Type": "application/json" },
    "wantStatus": 201,
    "wantContentType": "application/json",
    "wantBodyContains": "\"a\":1"
  },
  {
    "name": "query is parsed",
    "method": "GET",
    "path": "/query?a=1&b=2",
    "wantStatus": 200,
    "wantContentType": "application/json",
    "wantBodyContains": "\"a\":\"1\""
  },
  {
    "name": "unknown path falls back to 404",
    "method": "GET",
    "path": "/missing",
    "wantStatus": 404,
    "wantBodyContains": "not found"
  }
]
