[
  {
    "name": "promise fetch returns the response text",
    "method": "GET",
    "path": "/fetch/promise",
    "wantStatus": 200,
    "wantContentType": "application/json",
    "wantBodyEquals": "{\"status\":200,\"text\":\"hello world\"}"
  },
  {
    "name": "fetch exposes response headers and status",
    "method": "GET",
    "path": "/fetch/headers",
    "wantStatus": 200,
    "wantBodyContains": "\"custom\":\"yes\""
  },
  {
    "name": "fetch sends method, headers, and body",
    "method": "GET",
    "path": "/fetch/post",
    "wantStatus": 200,
    "wantBodyContains": "\"a\":1"
  },
  {
    "name": "fetch streams the response body",
    "method": "GET",
    "path": "/fetch/stream",
    "wantStatus": 200,
    "wantBodyEquals": "hello world"
  },
  {
    "name": "fetch rejects a blocked host",
    "method": "GET",
    "path": "/fetch/reject",
    "wantStatus": 502,
    "wantBodyContains": "not in fetch_allow"
  }
]