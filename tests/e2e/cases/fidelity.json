[
  {
    "name": "queryAll returns every value",
    "method": "GET",
    "path": "/queryall?a=1&a=2",
    "wantStatus": 200,
    "wantContentType": "application/json",
    "wantBodyContains": "\"a\":[\"1\",\"2\"]"
  },
  {
    "name": "res.set writes a header",
    "method": "GET",
    "path": "/header",
    "wantStatus": 200,
    "wantBodyEquals": "ok",
    "wantHeaders": {
      "X-Custom": "yes"
    }
  },
  {
    "name": "res.type sets content type",
    "method": "GET",
    "path": "/type",
    "wantStatus": 200,
    "wantContentType": "text/csv",
    "wantBodyEquals": "a,b"
  },
  {
    "name": "res.redirect sends a location",
    "method": "GET",
    "path": "/redirect",
    "wantStatus": 302,
    "wantHeaders": {
      "Location": "/hello"
    }
  },
  {
    "name": "res.end sends no body",
    "method": "GET",
    "path": "/end",
    "wantStatus": 204,
    "wantBodyEquals": ""
  },
  {
    "name": "urlencoded body is parsed",
    "method": "POST",
    "path": "/form",
    "body": "a=1&b=2",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
    },
    "wantStatus": 200,
    "wantContentType": "application/json",
    "wantBodyContains": "\"a\":\"1\""
  },
  {
    "name": "urlencoded repeated field keeps every value",
    "method": "POST",
    "path": "/form",
    "body": "a=1&a=2&b=3",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
    },
    "wantStatus": 200,
    "wantContentType": "application/json",
    "wantBodyContains": "\"a\":[\"1\",\"2\"]"
  },
  {
    "name": "req.header reads a request header",
    "method": "GET",
    "path": "/echoheader",
    "headers": {
      "X-Test": "hello"
    },
    "wantStatus": 200,
    "wantBodyEquals": "hello"
  },
  {
    "name": "multipart body is parsed",
    "method": "POST",
    "path": "/form",
    "body": "--X\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n1\r\n--X\r\nContent-Disposition: form-data; name=\"b\"\r\n\r\n2\r\n--X--\r\n",
    "headers": {
      "Content-Type": "multipart/form-data; boundary=X"
    },
    "wantStatus": 200,
    "wantContentType": "application/json",
    "wantBodyContains": "\"a\":\"1\""
  }
]
